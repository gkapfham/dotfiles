# set font "Hack Nerd Font 12"
set font "Maple Mono NF"

set database "sqlite"

# copy selection to system clipboard
set selection-clipboard clipboard

set synctex true
set synctex-editor-command "nvr --remote +"%line" "%file""

set window-title-basename "true"

# zathura-extract script binding
map <C-c> exec sh -c 'zathura-extract "$1" "$2"' _ %f %p

#
# Custom color theme based on Neovim colorscheme
# Supports both light and dark modes with seamless toggling
#

# Default to light mode (set recolor to false initially)
# Toggle with 'i' key or set recolor to true for dark mode

# Your custom colors:
# bg="#1c1c1c", fg="#d2d2d2", red="#d75347", orange="#d78700"
# yellow="#b7b757", green="#6f9500", cyan="#00afaf", blue="#87afd7"
# purple="#a569a5", white="#b2b2b2", black="#767676", gray="#6c6c6c"
# highlight="#585858", comment="#808080", menu="#262626", darkmenu="#303030"

#
# LIGHT MODE (Default)
#

# Background and foreground
set default-bg                    "#f5f5f5"     # Light background
set default-fg                    "#1c1c1c"     # Dark text

# Status bar (using dark menu color for contrast)
set statusbar-bg                  "#303030"     # darkmenu
set statusbar-fg                  "#d2d2d2"     # fg

# Input bar
set inputbar-bg                   "#ffffff"     # Pure white for input
set inputbar-fg                   "#1c1c1c"     # Dark text

# Notifications
set notification-bg               "#f5f5f5"     # Light background
set notification-fg               "#1c1c1c"     # Dark text
set notification-error-bg         "#d75347"     # red
set notification-error-fg         "#ffffff"     # White text on error
set notification-warning-bg       "#d78700"     # orange
set notification-warning-fg       "#1c1c1c"     # Dark text on warning

# Completion menu
set completion-bg                 "#ffffff"     # White
set completion-fg                 "#1c1c1c"     # Dark text
set completion-group-bg           "#f0f0f0"     # Slightly darker
set completion-group-fg           "#6c6c6c"     # gray
set completion-highlight-bg       "#87afd7"     # blue (selection)
set completion-highlight-fg       "#1c1c1c"     # Dark text

# Index (table of contents)
set index-bg                      "#f5f5f5"     # Light background
set index-fg                      "#1c1c1c"     # Dark text
set index-active-bg               "#87afd7"     # blue (current item)
set index-active-fg               "#1c1c1c"     # Dark text

# Highlights
set highlight-color               "#b7b757"     # yellow (search matches)
set highlight-active-color        "#d78700"     # orange (current match)

# Render loading
set render-loading                true
set render-loading-bg             "#f5f5f5"     # Light background
set render-loading-fg             "#6f9500"     # green

#
# RECOLOR MODE (Dark mode - toggle with 'i')
#

# When recolor is enabled, these swap the colors
set recolor-lightcolor            "#1c1c1c"     # bg (dark background in recolor mode)
set recolor-darkcolor             "#d2d2d2"     # fg (light text in recolor mode)

# Startup options
#
set adjust-open width

# Start in light mode (recolor off)
set recolor false

# Enable smooth scrolling
set smooth-scroll true

# Page padding
set page-padding 10

# Zoom settings
set zoom-min 10
set zoom-max 1000
