#!/bin/sh
# Stable launcher for the pi coding agent (used by pi-msg).
# Finds the newest pi in the npm npx cache (mirrors running pi via npx),
# then falls back to a system-installed pi (npm global /usr/local/bin).
# Copy/install to ~/.local/bin/pi.
pi_bin="$(ls -dt "$HOME"/.npm/_npx/*/node_modules/.bin/pi 2>/dev/null | head -1)"
[ -x "$pi_bin" ] || pi_bin=/usr/local/bin/pi
[ -x "$pi_bin" ] || pi_bin=/usr/bin/pi
exec "$pi_bin" "$@"
