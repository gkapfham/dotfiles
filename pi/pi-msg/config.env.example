# ===========================================================================
# pi-msg + XMPP setup — the ONLY file you need to edit on a new machine.
#
#   1. cp config.env.example config.env
#   2. edit config.env   (domain, accounts, passwords, model, workdir)
#   3. bash scripts/setup.sh
#
# Everything else (server config, bridge config, service file, TLS certs)
# is generated from these values. This file contains NO secrets by default:
# empty passwords are auto-generated during setup.
# ===========================================================================

# The XMPP domain — the "@..." part of your addresses, e.g. pi@<DOMAIN>.
# Use your server's resolvable name (on this laptop: the NetBird FQDN).
DOMAIN="diameno.netbird.cloud"

# Where the pi-msg bridge connects to the XMPP server (host:port).
#   - bridge on the same machine as the server:  "127.0.0.1:5222"
#   - bridge elsewhere, server on this box:      "<this-box-ip>:5222"
#   - leave empty: defaults to <DOMAIN>:5222 (bridge-only mode)
SERVICE="127.0.0.1:5222"

# Install the XMPP server (ejabberd) on THIS machine too?
#   yes -> full setup: server + bridge (needs sudo; Debian/Ubuntu packages)
#   no  -> bridge only: connect to an existing server (no server install)
ENABLE_SERVER="yes"

# Account names (the part before "@").
PI_USER="pi"            # the bot account
OWNER_USER="gkapfham"   # you — the trusted driver (the phone account)

# Passwords. Leave EMPTY to auto-generate during setup.
# Tip: simple passwords are much easier to type on a phone.
PI_PASSWORD=""
OWNER_PASSWORD=""

# The pi agent: model pattern and working directory (where it runs / finds AGENTS.md).
MODEL="opencode-go/deepseek-v4-flash"
WORKDIR="$HOME/configure/dotfiles"

# Hostnames/IPs to put on the TLS certificate (only used when ENABLE_SERVER=yes).
# Include the domain plus anything your phone will connect through.
CERT_HOSTS="$DOMAIN localhost 127.0.0.1"
