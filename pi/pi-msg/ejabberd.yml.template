# ejabberd configuration for pi-msg
#
# Template: setup-ubuntu.sh replaces __DOMAIN__ with your domain, installs the TLS
# certificate, and writes this to /etc/ejabberd/ejabberd.yml (Debian/Ubuntu)
# or into the NixOS config (see the repo README).
#
# Minimal setup: one host, one c2s listener (port 5222) with mandatory
# STARTTLS. One combined PEM file (private key + certificate + CA chain) is
# used so ejabberd can never fail to pair the key with the certificate.

hosts:
  - "__DOMAIN__"

loglevel: info

certfiles:
  - "/etc/ejabberd/certs/cert.pem"

listen:
  - port: 5222
    ip: "::"
    module: ejabberd_c2s
    max_stanza_size: 262144
    shaper: c2s_shaper
    access: c2s
    starttls: true
    starttls_required: true
    tls: false

s2s_use_starttls: optional

auth_method: internal

acl:
  local:
    user_regexp: ""

access_rules:
  c2s:
    deny: blocked
    allow: all

shaper:
  normal:
    rate: 3000
    burst_size: 20000

shaper_rules:
  max_user_sessions: 10
  max_user_offline_messages:
    5000: admin
    100: all
  c2s_shaper:
    none: admin
    normal: all

modules:
  # Needed for the change_password / check_account admin commands
  # (without it, ejabberdctl change_password is "unknown command")
  mod_admin_extra: {}
  mod_blocking: {}
  mod_caps: {}
  mod_carboncopy: {}
  mod_client_state: {}
  mod_disco: {}
  mod_offline:
    access_max_user_messages: max_user_offline_messages
  mod_ping: {}
  mod_privacy: {}
  mod_private: {}
  mod_roster:
    versioning: true
  mod_stream_mgmt:
    resend_on_timeout: if_offline
  mod_vcard: {}
  mod_version:
    show_os: false
