configuration {
	bw: 5;
    combi-hide-mode-prefix: true;
	location: 0;
	yoffset: 0;
	xoffset: 0;
	matching: "fuzzy";
	line-margin: 10;
	separator-style: "none";
	hide-scrollbar: false;
	show-icons: false;
	window-format: "󱡶  {t}";
	drun-display-format: "󰵆  {name}";
    sort: false;
	case-sensitive: false;
    smart-case: true;
    display-dmenu: "󰍜";
    display-drun: "󰵆";
    display-run: "󰧚";
    display-window: "󱡶";
    display-combi: "󰕮";
    display-ssh: "󰒋";
    display-filebrowser: "󰙅";
    /* mode switching in menus with more than one mode (the Control+Alt+O
       omni launcher): j = next, k = previous. These keys are free in i3,
       so there is no clash with a launcher binding; rofi's own defaults
       (Control+Tab / Shift+Right, Shift+Left / Control+Shift+Tab) are kept. */
    kb-mode-next:     "Control+Alt+j,Control+Tab,Shift+Right";
    kb-mode-previous: "Control+Alt+k,Shift+Left,Control+Shift+Tab";
}
@theme "/home/gkapfham/.config/rofi/themes/Minimal.rasi"
