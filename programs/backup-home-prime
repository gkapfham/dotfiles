#!/usr/bin/env bash
# NixOS-compatible backup script for borgmatic
# Usage: ./backup-home-prime [--dry-run] [--verbose] [--repository REPO-LABEL]

set -euo pipefail

# Configuration
CONFIG_FILE="${BORG_CONFIG:-$HOME/.config/borgmatic/remote.yaml}"
LOG_FILE="${BACKUP_LOG:-$HOME/backup.log}"
ARCHIVE_PREFIX="diameno-home"
VERBOSITY="1"
DRY_RUN=""
REPOSITORY=""

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Helper: extract host from borgmatic config for a given repository label
get_repo_host() {
    local label="$1"
    awk -v label="$label" '
        /^  - path: ssh:\/\// {
            host = $0
            gsub(/.*ssh:\/\/.*@/, "", host)
            gsub(/\/.*/, "", host)
        }
        /^    label:/ && $2 == label {
            print host
        }
    ' "$CONFIG_FILE" 2>/dev/null | head -1
}

# Helper: extract the first repository path from the config
get_first_repo_path() {
    awk '/^  - path:/ {
        gsub(/^  - path: /, "", $0)
        print
        exit
    }' "$CONFIG_FILE" 2>/dev/null
}

# Helper: extract repository path for a given label (works for SSH and local paths)
get_repo_path_for_label() {
    local label="$1"
    awk -v label="$label" '
        /^  - path:/ {
            path = $0
            gsub(/^  - path: /, "", path)
            gsub(/^"|"$/, "", path)
        }
        /^    label:/ && $2 == label {
            print path
        }
    ' "$CONFIG_FILE" 2>/dev/null | head -1
}

# Helper: check if the config uses SSH repos
config_uses_ssh() {
    grep -q "^  - path: ssh://" "$CONFIG_FILE" 2>/dev/null
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -c|--config)
            CONFIG_FILE="$2"
            echo -e "${YELLOW}Using config: $CONFIG_FILE${NC}"
            shift 2
            ;;
        --dry-run)
            DRY_RUN="--dry-run"
            echo -e "${YELLOW}Running in DRY-RUN mode (no actual backup)${NC}"
            shift
            ;;
        --repository)
            REPOSITORY="$2"
            echo -e "${YELLOW}Targeting repository: $REPOSITORY${NC}"
            shift 2
            ;;
        --verbose|-v)
            VERBOSITY="2"
            shift
            ;;
        --help|-h)
            echo "Usage: $0 [OPTIONS]"
            echo "  -c, --config FILE     Path to borgmatic config"
            echo "                        (default: ~/.config/borgmatic/remote.yaml)"
            echo "  --dry-run             Show what would be backed up without doing it"
            echo "  --verbose, -v         Show more detailed output"
            echo "  --repository LABEL    Backup only to a specific repository label"
            echo "                        (e.g., latent-remote or paragon-remote)"
            echo ""
            echo "Without --repository, backs up to all repositories in the config."
            echo ""
            echo "Environment variables:"
            echo "  BORG_CONFIG    Path to borgmatic config (default: ~/.config/borgmatic/remote.yaml)"
            echo "  BACKUP_LOG     Path to log file (default: ~/backup.log)"
            exit 0
            ;;
        *)
            echo -e "${RED}Unknown option: $1${NC}"
            echo "Use --help for usage information"
            exit 1
            ;;
    esac
done

# Check if config exists
if [[ ! -f "$CONFIG_FILE" ]]; then
    echo -e "${RED}Error: Config file not found: $CONFIG_FILE${NC}"
    exit 1
fi

# Check if passphrase file exists
PASSPHRASE_FILE="$HOME/.config/borgmatic/passphrase"
if [[ ! -f "$PASSPHRASE_FILE" ]]; then
    echo -e "${RED}Error: Passphrase file not found: $PASSPHRASE_FILE${NC}"
    exit 1
fi

# Check connectivity based on config type
if config_uses_ssh; then
    # --- SSH-based repo check (latent, paragon) ---
    if [[ -n "$REPOSITORY" ]]; then
        SSH_HOST=$(get_repo_host "$REPOSITORY")
        if [[ -z "$SSH_HOST" ]]; then
            echo -e "${RED}Error: Could not determine SSH host for repository label '$REPOSITORY'${NC}"
            echo "Check that the label exists in $CONFIG_FILE"
            exit 1
        fi
    else
        SSH_HOST="latent.netbird.cloud"
    fi

    echo -e "${YELLOW}Checking SSH connection to $SSH_HOST...${NC}"
    if ! ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no "gkapfham@$SSH_HOST" "echo 'SSH OK'" > /dev/null 2>&1; then
        echo -e "${RED}Error: Cannot connect to $SSH_HOST via SSH${NC}"
        echo "Make sure netbird is connected and the remote server is accessible"
        exit 1
    fi
    echo -e "${GREEN}SSH connection to $SSH_HOST successful${NC}"
else
    # --- Local repo check (Google Drive mount, etc.) ---
    REPO_PATH=""
    if [[ -n "$REPOSITORY" ]]; then
        REPO_PATH=$(get_repo_path_for_label "$REPOSITORY")
    fi
    if [[ -z "$REPO_PATH" ]]; then
        REPO_PATH=$(get_first_repo_path)
    fi

    if [[ ! -d "$REPO_PATH" ]]; then
        echo -e "${YELLOW}Repository path not found: $REPO_PATH${NC}"
        echo ""
        echo "If this is an rclone mount, make sure it is mounted first:"
        echo "  rclone mount cellveyor-google-drive: $REPO_PATH"
        echo ""
        echo -e "${YELLOW}Waiting 5 seconds before continuing (Ctrl+C to abort)...${NC}"
        sleep 5
    else
        echo -e "${GREEN}Repository path ok: $REPO_PATH${NC}"
    fi
fi

# Show backup info
echo -e "${YELLOW}Starting backup...${NC}"
echo "Config: $CONFIG_FILE"
echo "Log file: $LOG_FILE"
echo "Started at: $(date)"
echo "----------------------------------------"

# Build borgmatic arguments
BORGMATIC_ARGS=(
    --config "$CONFIG_FILE"
    create
    --verbosity "$VERBOSITY"
)

if [[ -n "$DRY_RUN" ]]; then
    BORGMATIC_ARGS+=(--dry-run)
fi

if [[ -n "$REPOSITORY" ]]; then
    BORGMATIC_ARGS+=(--repository "$REPOSITORY")
fi

# Run backup with logging
borgmatic "${BORGMATIC_ARGS[@]}" 2>&1 | tee "$LOG_FILE"
BACKUP_STATUS=$?

echo "----------------------------------------"
echo "Finished at: $(date)"

if [[ $BACKUP_STATUS -eq 0 ]]; then
    echo -e "${GREEN}Backup completed successfully!${NC}"
    
    # Show backup list
    echo ""
    echo "Recent backups:"
    LIST_CMD=(borgmatic --config "$CONFIG_FILE" list --verbosity 0)
    if [[ -n "$REPOSITORY" ]]; then
        LIST_CMD+=(--repository "$REPOSITORY")
    fi
    "${LIST_CMD[@]}" 2>&1 | tail -5
else
    echo -e "${RED}Backup failed with exit code: $BACKUP_STATUS${NC}"
    echo "Check log file: $LOG_FILE"
    exit 1
fi

# Cleanup old logs (keep last 10)
if [[ -d "$(dirname "$LOG_FILE")" ]]; then
    ls -t "$(dirname "$LOG_FILE")"/backup-*.log 2>/dev/null | tail -n +11 | xargs -r rm
fi
