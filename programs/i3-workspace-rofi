#!/usr/bin/env bash

# ── i3 workspace viewer via rofi ────────────────────────────────────────────
# Shows every workspace with its monitor label. Filtering by number or
# monitor name works. Selecting a workspace switches to it.
#
# Dependencies: i3 (i3-msg), jq, rofi

set -euo pipefail

entries=$(i3-msg -t get_workspaces | jq -r '
    [ .[] | { name: .name, output: .output, focused: .focused } ]
    | sort_by(.output, (.name | tonumber? // .))
    | .[]
    | "\(.name)  \(.output)  \(if .focused then "◂" else "" end)"
    | sub(" +$"; "")
')

selected=$(echo "$entries" | rofi -dmenu -p " " -i -no-custom)

if [ -n "$selected" ] && [[ "$selected" =~ ^[0-9]+ ]]; then
    i3-msg workspace number "$selected" >/dev/null
fi
