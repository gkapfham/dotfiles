#!/usr/bin/env bash

# Set the default values for the flags
EXTERNAL_MONITOR=false
MOBILE_MONITOR=false
RESET_MONITORS=false
LIST_MONITORS=false
DISPLAY_HELP=false

# Check for flags
for arg in "$@"; do
  case $arg in
    --external-monitor)
      EXTERNAL_MONITOR=true
      ;;
    --mobile-monitor)
      MOBILE_MONITOR=true
      ;;
    --reset-monitors)
      RESET_MONITORS=true
      ;;
    --list-monitors)
      LIST_MONITORS=true
      ;;
    --help)
      DISPLAY_HELP=true
      ;;
  esac
done

# Display the main help message if the --help flag is set
if [ "$DISPLAY_HELP" == true ]; then
  echo ""
  echo " Usage: connect-external-monitor [options]"
  echo "󰇀 Default use connects an external monitor to the main screen"
  echo ""
  echo " Options:"
  echo "  --external-monitor Connect an external monitor (i.e., a 27 inch 4K screen) above the main screen"
  echo "  --mobile-monitor   Connect a mobile monitor (i.e., a tablet) to the left of the main screen"
  echo "  --reset-monitors   Reset the monitors to the default configuration using main screen"
  echo "  --list-monitors    List the connected monitors and their modes"
  echo "  --help             Display this help message"
  exit 0
fi

# Run the reset command if the --reset-monitors flag is set
if [ "$RESET_MONITORS" == true ]; then
  xrandr -s 0
  exit 0
fi

# Run the listing command if the --list-monitors flag is set
if [ "$LIST_MONITORS" == true ]; then
  xrandr
  exit 0
fi

# Use fzf to select from one of the connected displays
CONNECTED_DISPLAYS=$(xrandr | grep connected | fzf --prompt " ")
DISPLAY_PORT=$(echo "$CONNECTED_DISPLAYS" | awk '{print $1}')

# Add a mode that will support the connection
# of a tablet as a secondary display using
# a program like weylus or deskcreen.

if [ "$MOBILE_MONITOR" == true ]; then
  xrandr --addmode DP-1 1920x1200
fi

# --> Option for the higher resolution laptop panel:

# Connected external display to the Framework 13 laptop:
# - Note that this is complicated because
# the resolutions of the two displays are different
# - Note also that this is different than the prior
# example because the Framework 13 laptop has a
# new panel that is of a higher resolution than the
# stock panel that was available at laptop purchase.

# xrandr --output eDP-1 --primary --mode 2880x1920 --pos 400x2160 --rotate normal --output DP-1 --mode 1920x1200 --left-of eDP-1 --output DP-2 --off --output DP-3 --off --output DP-4 --off --output DP-5 --off --output DP-6 --off --output ${DISPLAY_PORT} --mode 3840x2160 --pos 0x0 --rotate normal

# --mode 3840x2400 --scale 0.76x0.76
# --scale 0.76x0.76

# Case 1: Set both mobile and external monitors
if [ "$MOBILE_MONITOR" == true ] && [ "$EXTERNAL_MONITOR" == true ]; then
 xrandr --output eDP-1 --primary --mode 2880x1920 --pos 400x2160 --rotate normal --output DP-2 --mode 2560x1600 --right-of eDP-1 --output DP-1 --off --output DP-2 --off --output DP-4 --off --output DP-5 --off --output DP-6 --off --output ${DISPLAY_PORT} --mode 3840x2160 --pos 0x0 --rotate normal 
# Case 2: Set only the mobile monitor
elif [ "$MOBILE_MONITOR" == true ] && [ "$EXTERNAL_MONITOR" != true ]; then
  xrandr --output eDP-1 --primary --mode 2880x1920 --rotate normal --output DP-1 --mode 1920x1200 --left-of eDP-1 --output DP-2 --off --output DP-3 --off --output DP-4 --off --output DP-5 --off --output DP-6 --off --output ${DISPLAY_PORT} --off
# Case 3: Set only the external monitor
elif [ "$MOBILE_MONITOR" != true ] && [ "$EXTERNAL_MONITOR" == true ]; then
  xrandr --output eDP-1 --primary --mode 2880x1920 --pos 400x2160 --rotate normal --output DP-1 --off --output DP-2 --off --output DP-3 --off --output DP-4 --off --output DP-5 --off --output DP-6 --off --output ${DISPLAY_PORT} --mode 3840x2160 --pos 0x0 --rotate normal
fi

# Set the root color of the desktop;
# this tends to reset on the Framework 13 laptop
# hsetroot -solid "#875f87"
hsetroot -solid "#a569a5"
