# Start profile {{{

# User login details
IMAPStore gkapfham@allegheny.edu-remote
Host imap.gmail.com
Port 993
User gkapfham@allegheny.edu
PassCmd "pass gkapfham@allegheny.edu"
AuthMechs LOGIN
TLSType IMAPS
CertificateFile /etc/ssl/certs/ca-certificates.crt

# Mail storage location
MaildirStore gkapfham@allegheny.edu-local
Subfolders Verbatim
Path /home/gkapfham/.local/share/mail/gkapfham@allegheny.edu/
Inbox /home/gkapfham/.local/share/mail/gkapfham@allegheny.edu/INBOX

# Remote folders to download to the local machine
Channel gkapfham@allegheny.edu
Expunge Both
Far :gkapfham@allegheny.edu-remote:
Near :gkapfham@allegheny.edu-local:
Patterns "INBOX" "Trash" "advise2024" "advise" "dept2024" "dept" "fitter" "framework" "friends" "github" "gradingforgrowth" "irb2024" "jsep2023" "research2024" "research" "reviews2023" "reviews2024" "reviews" "seradio" "tab" "teaching2024" "teaching"
Create Both
SyncState *
MaxMessages 1000
ExpireUnread no

# }}}
