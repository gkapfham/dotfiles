keybinds clear-defaults=true {
    normal {
        bind "Ctrl a" { SwitchToMode "tmux"; }
        bind "Ctrl e" { EditScrollback; }
        bind "Alt h" { MoveFocus "left"; }
        bind "Alt j" { MoveFocus "down"; }
        bind "Alt k" { MoveFocus "up"; }
        bind "Alt l" { MoveFocus "right"; }
        bind "Alt n" { NewPane; }
        bind "Ctrl q" { Quit; }
    }
    locked {
        bind "Ctrl g" { SwitchToMode "normal"; }
    }
    scroll {
        bind "PageDown" { PageScrollDown; }
        bind "PageUp" { PageScrollUp; }
        bind "/" { SwitchToMode "entersearch"; SearchInput 0; }
        bind "Ctrl b" { PageScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "Ctrl d" { HalfPageScrollDown; }
        bind "e" { EditScrollback; SwitchToMode "normal"; }
        bind "Ctrl f" { PageScrollDown; }
        bind "h" { PageScrollUp; }
        bind "j" { ScrollDown; }
        bind "k" { ScrollUp; }
        bind "l" { PageScrollDown; }
        bind "q" { SwitchToMode "normal"; }
        bind "s" { SwitchToMode "entersearch"; SearchInput 0; }
        bind "u" { HalfPageScrollUp; }
        bind "Ctrl u" { HalfPageScrollUp; }
        bind "y" { Copy; }
        bind "Ctrl n" { PageScrollDown; }
        bind "Ctrl p" { PageScrollUp; }
    }
    search {
        bind "N" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "n" { Search "down"; }
        bind "o" { SearchToggleOption "WholeWord"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "esc" { ScrollToBottom; SwitchToMode "normal"; }
    }
    shared_except "locked" {
        bind "Ctrl g" { SwitchToMode "locked"; }
        bind "Alt p" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "normal"
        }
        bind "Alt y" {
            LaunchOrFocusPlugin "zellij-pane-picker" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "normal"
        }
    }
    shared_among "scroll" "search" {
        bind "Ctrl c" { ScrollToBottom; SwitchToMode "normal"; }
    }
    shared_among "scroll" "tmux" {
        bind "esc" { SwitchToMode "normal"; }
    }
    entersearch {
        bind "Ctrl c" { SwitchToMode "scroll"; }
        bind "esc" { SwitchToMode "scroll"; }
        bind "enter" { SwitchToMode "search"; }
    }
    renametab {
        bind "esc" { UndoRenameTab; SwitchToMode "normal"; }
    }
    shared_among "renametab" "renamepane" {
        bind "enter" { SwitchToMode "normal"; }
    }
    renamepane {
        bind "esc" { UndoRenamePane; SwitchToMode "normal"; }
    }
    tmux {
        bind "," { SwitchToMode "renametab"; TabNameInput 0; }
        bind "-" { NewPane "down"; SwitchToMode "normal"; }
        bind "." { SwitchToMode "renamepane"; PaneNameInput 0; }
        bind "1" { GoToTab 1; SwitchToMode "normal"; }
        bind "2" { GoToTab 2; SwitchToMode "normal"; }
        bind "3" { GoToTab 3; SwitchToMode "normal"; }
        bind "4" { GoToTab 4; SwitchToMode "normal"; }
        bind "5" { GoToTab 5; SwitchToMode "normal"; }
        bind "6" { GoToTab 6; SwitchToMode "normal"; }
        bind "7" { GoToTab 7; SwitchToMode "normal"; }
        bind "8" { GoToTab 8; SwitchToMode "normal"; }
        bind "9" { GoToTab 9; SwitchToMode "normal"; }
        bind "B" { Resize "Increase down"; }
        bind "T" { Resize "Increase up"; }
        bind "[" { SwitchToMode "scroll"; }
        bind "Ctrl a" { Write 1; SwitchToMode "normal"; }
        // bind "b" { GoToPreviousTab; SwitchToMode "normal"; }
        bind "b" { WriteChars "]52;c;?"; SwitchToMode "normal"; }
        bind "c" { NewTab; SwitchToMode "normal"; }
        bind "d" { Detach; }
        bind "f" { Resize "Increase left"; }
        bind "g" { Resize "Increase right"; }
        bind "h" { MoveFocus "left"; SwitchToMode "normal"; }
        bind "H" { MovePane "left"; SwitchToMode "normal"; }
        bind "i" { TogglePaneFrames; SwitchToMode "normal"; }
        bind "j" { MoveFocus "down"; SwitchToMode "normal"; }
        bind "J" { MovePane "down"; SwitchToMode "normal"; }
        bind "k" { MoveFocus "up"; SwitchToMode "normal"; }
        bind "K" { MovePane "up"; SwitchToMode "normal"; }
        bind "l" { MoveFocus "right"; SwitchToMode "normal"; }
        bind "L" { MovePane "right"; SwitchToMode "normal"; }
        bind "n" { GoToNextTab; SwitchToMode "normal"; }
        bind "o" { FocusNextPane; SwitchToMode "normal"; }
        bind "p" { GoToPreviousTab; SwitchToMode "normal"; }
        bind "r" {
            MessagePlugin "configuration" {
                name "reload_config"
                floating false
            }
            SwitchToMode "normal"
        }
        bind "w" {
            WriteChars "zellij action dump-layout > ~/.config/zellij/layouts/"
            SwitchToMode "normal"
        }
        bind "x" { CloseFocus; SwitchToMode "normal"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "normal"; }
        bind "|" { NewPane "right"; SwitchToMode "normal"; }
    }
}
themes {
    custom-tmux {
        text_unselected {
            base 178 178 178
            background 28 28 28
            emphasis_0 215 135 0
            emphasis_1 215 95 95
            emphasis_2 111 149 0
            emphasis_3 165 105 165
        }
        text_selected {
            base 178 178 178
            background 28 28 28
            emphasis_0 215 135 0
            emphasis_1 215 95 95
            emphasis_2 111 149 0
            emphasis_3 165 105 165
        }
        ribbon_selected {
            base 111 149 0
            background 28 28 28
            emphasis_0 28 28 28
            emphasis_1 28 28 28
            emphasis_2 28 28 28
            emphasis_3 28 28 28
        }
        ribbon_unselected {
            base 178 178 178
            background 28 28 28
            emphasis_0 28 28 28
            emphasis_1 28 28 28
            emphasis_2 28 28 28
            emphasis_3 28 28 28
        }
        table_title {
            base 111 149 0
            background 28 28 28
