            emphasis_1 215 95 95
            emphasis_2 111 149 0
            emphasis_3 165 105 165
        }
        table_cell_selected {
            base 215 135 0
            background 28 28 28
            emphasis_0 215 135 0
            emphasis_1 215 135 0
            emphasis_2 215 135 0
            emphasis_3 215 135 0
        }
        table_cell_unselected {
            base 178 178 178
            background 28 28 28
            emphasis_0 210 210 210
            emphasis_1 210 210 210
            emphasis_2 210 210 210
            emphasis_3 210 210 210
        }
        list_selected {
            base 215 135 0
            background 28 28 28
            emphasis_0 215 135 0
            emphasis_1 215 135 0
            emphasis_2 215 135 0
            emphasis_3 215 135 0
        }
        list_unselected {
            base 210 210 210
            background 28 28 28
            emphasis_0 210 210 210
            emphasis_1 210 210 210
            emphasis_2 210 210 210
            emphasis_3 210 210 210
        }
        frame_selected {
            base 111 149 0
            background 0
