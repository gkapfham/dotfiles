// Nixos layout - equivalent to ~/.tmuxinator/Nixos.yml
// Root directory: ~/configure/nixos

layout {

    cwd "~/configure/nixos"
    
    // Use compact bar at the BOTTOM (matches your config)
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
    }

    // Tab 1: Edit
    tab name="Edit" {
        pane name=" Code" focus=true
    }

    // Tab 2: Control
    // Split vertically with GitHub (lazygit) on top, Commands on bottom
    tab name="Control" split_direction="vertical" {
        pane name=" GitHub" command="lazygit" size="50%"
        pane name="󰘳 Commands" size="50%"
    }

}
