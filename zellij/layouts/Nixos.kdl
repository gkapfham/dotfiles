layout {
    cwd "/home/gkapfham/configure/nixos"
    tab name="Editor" {
        pane name="Neovim" focus=true
        pane size=1 borderless=true {
            plugin location="zjstatus"
        }
    }
    tab name="Processor" hide_floating_panes=true {
        pane size="50%" split_direction="vertical" {
            pane command="lazygit" name="GitHub" size="50%" {
                start_suspended false
            }
            pane name="Files" size="50%"
        }
        pane size="50%" split_direction="vertical" {
            pane name="Commands" size="50%"
            pane name="Explore" size="50%"
        }
        pane size=1 borderless=true {
            plugin location="zjstatus"
        }
    }
    tab name="Agents" hide_floating_panes=true {
        pane command="dx" name="OpenCode" {
          args "opencode-ai@latest"
            start_suspended true
        }
        pane size=1 borderless=true {
            plugin location="zjstatus"
        }
    }
    new_tab_template {
        pane cwd="/home/gkapfham/configure/nixos"
        pane size=1 borderless=true {
            plugin location="zjstatus"
        }
    }
}
