layout {
    cwd "/home/gkapfham/working/web/www.prosegrammers.com"
    tab name="Edit" hide_floating_panes=true {
        pane name="Code"
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
    }
    tab name="Process" focus=true hide_floating_panes=true {
        pane size="50%" split_direction="vertical" {
            pane name="Quarto" focus=true size="50%" {
            }
            pane name="Files" size="50%"
        }
        pane size="50%" split_direction="vertical" {
            pane command="lazygit" name="GitHub" size="50%" {
                start_suspended true
            }
            pane name="Explore" size="50%"
        }
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
    }
    new_tab_template {
        pane cwd="/home/gkapfham/configure/dotfiles"
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
    }
}

